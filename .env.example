# ClickHouse Cloud — set these as Railway environment variables on the service.
CLICKHOUSE_HOST=your-instance.us-west-2.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# ETL knobs (optional; defaults in etl_to_clickhouse.py)
# TOTAL_ROWS=1000000000
# MONTHS=202501,202502,202503,202504,202505,202506,202507,202508,202509,202510,202511,202512
# SHARD_ROWS=500000        # drop to 200000 if running cross-region and inserts time out
# WORKERS=2
# SEED=42

# HTTP timeouts for CH client; bump if Railway region is far from CH region
# (defaults are sized for cross-region; lower locally if you want fail-fast)
# CH_CONNECT_TIMEOUT=120
# CH_SEND_RECEIVE_TIMEOUT=600

# Backblaze B2 — only needed if you also run generate_synthetic_to_s3.py / export_to_s3.py
# INGESTION_AWS_ACCESS_KEY_ID=
# INGESTION_AWS_SECRET_ACCESS_KEY=
# INGESTION_BUCKET=
# INGESTION_ENDPOINT_URL=s3.us-east-005.backblazeb2.com
